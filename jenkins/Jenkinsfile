pipeline {
    agent {
        docker {
            image 'snakee/golang-junit:1.21'
            reuseNode true
            args '-u root:root -e GOCACHE=/tmp/go-build -e GOTMPDIR=/tmp/go-tmp -e HOME=/tmp'
        }
    }

    environment {
        GOCACHE = '/tmp/go-build'
        GOTMPDIR = '/tmp/go-tmp'
        HOME = '/tmp'
    }

    stages {
        stage('Unit Tests-Backend') {
            steps {
                sh '''
                    mkdir -p "$GOCACHE" "$GOTMPDIR"
                    cd bugtracker-backend
                    go test -v ./...
                '''
            }
        }
        stage ('Unit Tests-Frontend') {
            agent{
                docker {
                    image 'node:20-alpine'
                    reuseNode true
                }
            }
            steps {
                dir('bugtracker-frontend') {
                    sh '''
                     npm ci
                     npm test
                    '''
                }
            }
        }   
    }
}